[Unit]
Description=Agm Server Init
SourcePath=/usr/bin/agm_server
After=init_audio.service
Requires=init_audio.service
StartLimitIntervalSec=0
StartLimitBurst=10

[Service]
Type=dbus
User=audio
Group=audio
BusName=org.Qti.AgmService
SystemdService=dbus-org.Qti.AgmService.service
Restart=on-failure
RestartSec=1
ExecStart=/usr/bin/agm_server -s
ExecReload=/usr/bin/agm_server -r
NotifyAccess=main

[Install]
WantedBy=multi-user.target
