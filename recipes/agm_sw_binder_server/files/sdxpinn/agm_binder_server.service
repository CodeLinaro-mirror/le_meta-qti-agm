[Unit]
Description=Agm Server Init
SourcePath=/usr/bin/agm_server
After=init_audio.service
Requires=init_audio.service

[Service]
User=audio
Group=audio
SupplementaryGroups=logd
Restart=on-failure
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_NICE CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_NICE CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/agm_server -s
ExecReload=/usr/bin/agm_server -r

[Install]
WantedBy=multi-user.target
